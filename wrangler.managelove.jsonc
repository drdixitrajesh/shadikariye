{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "managelove",
  "account_id": "0806706663c74737529a2e2f9de75440",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "dist/client" },
  "vars": { "STANDALONE_MODE": "demo", "TURNSTILE_SITE_KEY": "0x4AAAAAAFR5uwPEgcKjcCzJ" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "managelove-test-portal",
    "database_id": "ea008378-69be-45ef-b609-07b18e599f81",
    "migrations_dir": "drizzle"
  }],
  "workers_dev": true,
  "routes": [
    { "pattern": "managelove.com/*", "zone_name": "managelove.com" },
    { "pattern": "www.managelove.com/*", "zone_name": "managelove.com" }
  ],
  "preview_urls": false,
  "observability": { "enabled": false }
}
