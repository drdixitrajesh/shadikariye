    {
      "name": "Profile card",
      "kind": "card",
      "description": "The implemented no-photo card fallback, with illustrative member text; production portraits use the catalog asset or a volunteered upload.",
      "html": "<article class=\"ds-card\"><div class=\"ds-portrait\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"8\" r=\"5\"></circle><path d=\"M20 21a8 8 0 0 0-16 0\"></path></svg><span>Photo not added / फोटो नहीं है</span><span class=\"ds-member\">सदस्य प्रोफ़ाइल</span></div><div class=\"ds-card-body\"><button class=\"ds-name\"><h3>सदस्य का नाम</h3></button><p class=\"ds-meta\">28 वर्ष · 165 cm · अविवाहित</p><p class=\"ds-community\">कान्यकुब्ज · शाण्डिल्य गोत्र</p><div class=\"ds-facts\"><p>नई दिल्ली</p><p>शिक्षा और पेशा</p></div><button class=\"ds-view\">प्रोफ़ाइल देखें</button></div></article>",
      "css": ".ds-card{max-width:330px;background:var(--card,#fff);color:var(--foreground,#2d2630);border:1px solid #e2dcdd;border-radius:12px;overflow:hidden;transition:border-color 180ms;font-family:'Noto Sans Devanagari','DM Sans',sans-serif;}.ds-card:hover{border-color:#b293a1}.ds-portrait{position:relative;aspect-ratio:1.25;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;background:#eee7eb;color:#745065;overflow:hidden}.ds-portrait>svg{width:55px;height:55px}.ds-portrait>span{font-size:12px}.ds-portrait>.ds-member{position:absolute;left:12px;top:12px;background:#fffffff0;border-radius:5px;color:#495f48;font-size:11px;padding:5px 8px;line-height:1.4}.ds-card-body{padding:19px 17px 17px}.ds-name{border:0;background:none;padding:0;text-align:left;color:inherit;cursor:pointer}.ds-name h3{margin:0;font-family:\"Cormorant Garamond\",serif;font-size:1.65rem;font-weight:600;letter-spacing:-.015em;line-height:1.15}.ds-name:hover{color:var(--primary,#68384c)}.ds-name:focus-visible{outline:3px solid var(--ring,#9b6e80);outline-offset:3px}.ds-meta{font-size:12px;color:#796e75;margin:7px 0 0;line-height:1.7}.ds-community{font-size:12px;color:#75495c;margin:7px 0 0;font-weight:500;line-height:1.7}.ds-facts{border-top:1px solid #eee8ea;margin-top:15px;padding-top:13px;display:flex;flex-direction:column;gap:7px}.ds-facts p{margin:0;font-size:12px;color:#6d626a;line-height:1.5}.ds-view{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:11px 19px;border-radius:7px;border:1px solid var(--primary,#68384c);font-size:14px;font-weight:600;line-height:1.5;text-align:center;cursor:pointer;font-family:'Noto Sans Devanagari','DM Sans',sans-serif;width:100%;margin-top:17px;min-height:39px;padding:8px 10px;font-size:13px;background:var(--card,#fff);color:var(--primary,#68384c);border-color:#ded0d6}.ds-view:hover{background:#f7f0f3}.ds-view:focus-visible{outline:3px solid var(--ring,#9b6e80);outline-offset:3px}@media(max-width:760px){.ds-portrait{aspect-ratio:1.12}}@media(prefers-reduced-motion:reduce){.ds-card{transition-duration:.001ms}}",
      "refersTo": "profile-card"
    },
    {
      "name": "Interest action",
      "kind": "button",
      "description": "Compact heart action adjoining View profile.",
      "html": "<button class=\"ds-interest\" aria-label=\"रुचि भेजें\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5\"></path></svg></button>",
      "css": ".ds-interest{width:42px;min-height:39px;border:1px solid #e4d6de;border-radius:6px;background:#f7f0f3;color:#8b5a70;display:grid;place-items:center;cursor:pointer}.ds-interest:hover{background:#eee0e7}.ds-interest:focus-visible{outline:3px solid var(--ring,#9b6e80);outline-offset:3px}.ds-interest:disabled{opacity:.55;cursor:not-allowed}"
