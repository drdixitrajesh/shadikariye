      "html": "<label class=\"ds-label\" for=\"ds-name\">पूरा नाम</label><input class=\"ds-input\" id=\"ds-name\" placeholder=\"आपका नाम\">",
      "css": ".ds-label{display:block;margin-bottom:7px;font-size:14px;font-weight:500;color:#4e4049;font-family:'Noto Sans Devanagari','DM Sans',sans-serif;}.ds-input{font-family:'Noto Sans Devanagari','DM Sans',sans-serif;font-size:16px;color:var(--foreground,#2d2630);width:100%;border:1px solid var(--input,#d8d2d5);border-radius:7px;padding:11px 12px;background:var(--card,#fff);min-height:44px;caret-color:var(--primary,#68384c)}.ds-input::placeholder{color:#777079}.ds-input:focus{border-color:#8c5d73}.ds-input:focus-visible{outline:3px solid var(--ring,#9b6e80);outline-offset:3px}",
