  "narrative": {
    "northStar": "The Indian Family Album",
    "overview": "Vaidik Milan pairs the warmth of a family album with a light, functional matching workspace. Plum accents, paper-like backgrounds, fine dividers and serif identity type make profiles feel personal. Portraits carry the visual weight; filters and profile facts stay immediately useful. The original Vaidik Milan identity is the brand authority.\n\nHindi is the default language, with an English option. Devanagari receives its own sans and serif fonts, sizes and line heights. Free access, visible fictional-demo labels and explicit sharing consent are durable product commitments that shape interface copy and hierarchy.\n\nThis document is source-derived from `app/globals.css`, `app/milan.tsx` and the local UI primitives. Responsive behavior and image framing described here are **unrendered assumptions**: no browser screenshots or computed-style sampling were available. The parent implementation reports that typecheck and the Worker build pass; those checks do not establish visual rendering. Frontmatter values record current source, including the final CSS overrides. Sidecar tonal ramps are synthesized panel previews, not application tokens.",
    "keyCharacteristics": [
      "Warm plum and off-white paper with white working surfaces.",
      "Serif identity and headings with readable bilingual sans text.",
      "Portrait-led profiles with compact facts and visible provenance.",
      "Flat surfaces at rest; stronger depth reserved for overlays.",
      "Immediate community browsing and separate community and gotra controls."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Use the existing plum for identity and selection. Reserve green, ochre and destructive red for their current status roles.",
        "section": "colors"
      },
      {
        "name": "The Script Respect Rule",
        "body": "Apply the existing language-specific font order and heading metrics whenever adding a bilingual heading. Allow Hindi labels to wrap without clipping.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Keep resting profile surfaces flat. Use the established shadows for controls and overlays where depth explains interaction.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use plum, serif identity type and warm paper surfaces to retain the family-album character.",
      "**Do** keep community and gotra distinct, immediately available filter concepts.",
      "**Do** preserve Hindi-specific fonts and metrics, with a visible English switch.",
      "**Do** keep fictional portrait provenance and member self-reporting clear in the catalog and detail views.",
      "**Do** keep publishing consent explicit and every matching feature free.",
      "**Do** preserve the final portrait aspect ratios and three-by-two image translation relationship.",
      "**Do** verify responsive wrapping and generated-image framing in a browser before claiming rendered visual validation."
    ],
    "donts": [
      "**Don't** add paid contact gates, premium badges or upsell surfaces.",
      "**Don't** imply that a demo person is a real member or that a member label means independently verified identity.",
      "**Don't** infer community or gotra from a surname or turn a filter into religious certification.",
      "**Don't** populate the catalog with scraped social caste, gotra or contact information.",
      "**Don't** replace the original Vaidik Milan identity with a reference site's logo or name.",
      "**Don't** add heavy shadows to resting profile cards or obscure the working filters with an oversized introduction."
    ]
  }
}
