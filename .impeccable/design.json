  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "description": "Publish, accept or continue with the plum primary action.",
      "html": "<button class=\"ds-primary\">आगे बढ़ें</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:11px 19px;border-radius:7px;border:1px solid var(--primary,#68384c);font-size:14px;font-weight:600;line-height:1.5;text-align:center;cursor:pointer;font-family:'Noto Sans Devanagari','DM Sans',sans-serif;background:var(--primary,#68384c);color:var(--primary-foreground,#fff)}.ds-primary:hover{background:#532b3c;border-color:#532b3c}.ds-primary:focus-visible{outline:3px solid var(--ring,#9b6e80);outline-offset:3px}.ds-primary:disabled{opacity:.55;cursor:not-allowed}",
      "refersTo": "button-primary"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "description": "White action used for profile details and secondary choices.",
      "html": "<button class=\"ds-secondary\">प्रोफ़ाइल देखें</button>",
