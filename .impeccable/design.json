    {
      "name": "Line navigation",
      "kind": "nav",
      "description": "Desktop active-tab line navigation; production uses Radix tabs.",
      "html": "<nav class=\"ds-nav\" aria-label=\"मुख्य नेविगेशन\"><button class=\"ds-tab ds-active\" aria-current=\"page\">रिश्ते खोजें</button><button class=\"ds-tab\">मेरी पसंद</button><button class=\"ds-tab\">रुचियाँ</button></nav>",
      "css": ".ds-nav{display:flex;align-items:stretch;gap:25px;height:92px}.ds-tab{font-family:'Noto Sans Devanagari','DM Sans',sans-serif;position:relative;border:1px solid transparent;background:transparent;color:#726770;font-size:15px;font-weight:500;padding:0 1px;cursor:pointer}.ds-tab:hover{color:var(--foreground,#2d2630)}.ds-tab.ds-active{color:var(--primary,#68384c)}.ds-active::after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:3px;background:var(--primary,#68384c)}.ds-tab:focus-visible{outline:3px solid var(--ring,#9b6e80);outline-offset:3px}"
